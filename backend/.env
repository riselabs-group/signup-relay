DJANGO_SECRET_KEY=local-only-change-this
DJANGO_DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
# Production: set DATABASE_URL (and the POSTGRES_* values below) to use PostgreSQL.
# DATABASE_URL=postgresql://rise:strong-password@127.0.0.1:5432/rise
# POSTGRES_DB=rise
# POSTGRES_USER=rise
# POSTGRES_PASSWORD=strong-random-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
RELAY_NAME=R.I.S.E Relay
RELAY_DOMAIN=relay.example
REGISTRATION_OPEN=true
STALWART_DRY_RUN=true
# Production only: uncomment and fill these values.
# STALWART_JMAP_URL=https://mail-internal.example
# STALWART_ADMIN_TOKEN=server-only-token
# STALWART_DOMAIN_ID=domain-id-from-stalwart
IMAP_HOST=relay.example
SMTP_HOST=relay.example
# Production/multi-worker only:
# REDIS_URL=redis://127.0.0.1:6379/1
ALTCHA_REQUIRED=false
# Enable after the frontend challenge is enabled in production.
ALTCHA_HMAC_KEY=replace-with-32-byte-secret
