DJANGO_SECRET_KEY=local-only-change-this
DJANGO_DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
# Production: set DATABASE_URL (and the POSTGRES_* values below) to use PostgreSQL.
# DATABASE_URL=postgresql://rise:strong-password@127.0.0.1:5432/rise
# POSTGRES_DB=rise
# POSTGRES_USER=rise
# POSTGRES_PASSWORD=strong-random-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
RELAY_NAME=R.I.S.E Relay
RELAY_DOMAIN=relay.example
REGISTRATION_OPEN=true
# Provider selection. Stalwart is currently the only implementation.
EMAIL_PROVIDER=stalwart
# Local development remains safe by default: no remote account is created.
STALWART_DRY_RUN=true
# Production only: set DRY_RUN=false and fill these server-side secrets.
# STALWART_JMAP_URL=https://mail-internal.example
# STALWART_API_KEY=server-only-api-key
# STALWART_DOMAIN_ID=domain-id-from-stalwart
# STALWART_TIMEOUT_SECONDS=10
# STALWART_VERIFY_TLS=true
#
# Create a dedicated Stalwart service principal/API key. Grant only:
# authenticate, sysAccountCreate, sysAccountGet, sysAccountUpdate,
# and sysAccountDestroy only if product users may permanently delete mailboxes.
# Do not expose this key to React, a browser, or source control.
IMAP_HOST=relay.example
SMTP_HOST=relay.example
# Production/multi-worker only:
# REDIS_URL=redis://127.0.0.1:6379/1
ALTCHA_REQUIRED=false
# Enable after the frontend challenge is enabled in production.
ALTCHA_HMAC_KEY=replace-with-32-byte-secret
